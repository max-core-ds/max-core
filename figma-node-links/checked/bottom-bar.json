      },
      {
        "name": "Sub-components used inside Bottom Navigation. Not intended for direct use — they ship via the parent component, but you can override their swappable parts.",
        "id": "4622:892"
      },
      {
        "name": "Internal Card / _Nav Item",
        "id": "4622:893",
        "children": [
          {
            "name": "_Nav Item",
            "id": "4622:894"
          },
          {
            "name": "5 STATES · Default · Hover · Pressed · Active · Disabled · Property: Dot (boolean), Content Instance (swap)",
            "id": "4622:895"
          },
          {
            "name": "Single navigation item. Auto-layout vertical with icon above label. Active state has accent fill and slightly wider padding (visual emphasis). Disabled is dimmed (opacity 0.4).",
            "id": "4622:896"
