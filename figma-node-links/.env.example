# Copy to .env (gitignored) and fill in. Consumed by fetch-tree.sh.

# Figma personal access token — required. Never commit the real value.
# Create one at https://www.figma.com/developers/api#access-tokens
FIGMA_TOKEN=

# Figma file key, taken from the file URL: figma.com/design/<KEY>/<slug>
FIGMA_FILE_KEY=

# The slug segment after the key in the URL (the <slug> above).
# Only used to build clickable node links inside the tree — not required for the fetch.
FIGMA_FILE_SLUG=
